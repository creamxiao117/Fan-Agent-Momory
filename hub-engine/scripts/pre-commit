#!/usr/bin/env bash
# @version V3.0 / 2026-10-02 / pi / 三道 **scope-gated** 提交门禁（线数从 ~180 降到 ~10）
#
# 本文件只是**薄包装**；门禁逻辑全在 `hub-engine/scripts/gate_runner.py`（Python，可单测）。
#
# 为何重写（M0.5/Task 6）：
#   旧版 6 道门禁（编码/预算/渲染/markdownlint/ruff×2）里，
#   - 编码检查与渲染检查**各被实现两遍**（外层钩子 + 中枢钩子）⇒ 必然漂移；
#   - 渲染检查**无条件跑** ⇒ 工作树里**任何人**未提交的卡改动会阻断**任何**提交
#     ⇒ 实际效果是训练所有人用 `--no-verify`，从而让全部门禁一起失效
#       （巡检曾连续 18 天未跑，同一机制）。
#
# 现在：门禁触发范围由 **staged 内容**决定（见 `common/gate_scope.py`）：
#   code = staged 含未归档 .py        → ruff check + format
#   text = staged 含文本/.md/pre-commit → check_encoding + markdownlint
#   l0   = staged 触及 L0 面           → startup_budget + render_index --check
# 绝大多数提交只跑其中一道；改 L0 才跑重的那道。
#
# 退出码（由 gate_runner 给出）：0 通过 / 1 code / 2 text / 3 l0
# 安装：cp hub-engine/scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 绕过：`git commit --no-verify`——**本版的目标就是让它的合法用途归零**；若门禁故障请当场修。

set -u

PY="python"
for cand in ".venv/Scripts/python.exe" ".venv/bin/python" "python3"; do
    if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
done

exec "$PY" hub-engine/scripts/gate_runner.py --repo outer
