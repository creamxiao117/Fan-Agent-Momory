#!/usr/bin/env bash
# @version V1.1 / 2026-09-19 / Hermes / hub-engine pre-commit 编码+ruff 双门禁钩子
#
# 作用（两道门禁，先编码后 lint）：
#   0) 编码门禁：staged 文本文件跑 check_encoding.py，非 UTF-8 / BOM 不合规 /
#      乱码串残留 / .vbs 含非 ASCII → 阻断（依据 rules/chinese-text-encoding-discipline v1.0）
#   1) ruff check  → 不通过则阻断
#   2) ruff format --check → 不一致则阻断
#
# 触发原因：
#   - 2026-09-10 trae work ruff format 48 文件 2 天未 commit 未报警（实证）
#   - 2026-09-19 中文文本/路径乱码规范落地，把「人工跑 check_encoding.py」升级为提交时自动阻断
#
# 安装：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 绕过：git commit --no-verify（仅在明确知情时使用，并在 commit message 里说明原因）
#
# 退出码：
#   0 = 通过
#   1 = 阻断（ruff check 报错）
#   2 = 阻断（ruff format --check 不一致）
#   4 = 阻断（编码门禁未通过）
#
# 兼容：Windows + Linux + macOS（Git Bash）

set -e

echo "[pre-commit] hub-engine 门禁启动..."

# ---------- 0) 编码门禁（中文/非 ASCII 场景）----------
ENC_SCRIPT="hub-engine/scripts/check_encoding.py"
if [ -f "$ENC_SCRIPT" ]; then
    STAGED_TEXT=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(py|ps1|bat|cmd|vbs|js|ts|tsx|cs|c|cpp|h|hpp|go|rs|java|md|txt|json|yaml|yml|toml|ini|cfg|xml|csv)$|pre-commit' || true)
    if [ -n "$STAGED_TEXT" ]; then
        # shellcheck disable=SC2086
        if ENC_OUT=$(python "$ENC_SCRIPT" $STAGED_TEXT 2>&1); then
            ENC_RC=0
        else
            ENC_RC=$?
        fi
        # 只回显问题项，避免 100+ 行 PASS 刷屏
        echo "$ENC_OUT" | grep -E "^\[(FAIL|WARN)\]" || true
        if [ "$ENC_RC" -ne 0 ]; then
            echo "[pre-commit] ❌ 编码门禁未通过（见上），commit 阻断"
            echo "[pre-commit] 修法：按 rules/chinese-text-encoding-discipline 重写该文件编码"
            exit 4
        fi
        echo "[pre-commit] ✅ 编码门禁通过（$(echo "$STAGED_TEXT" | wc -l | tr -d ' ') 个文件）"
    else
        echo "[pre-commit] 无文本文件 staged，跳过编码门禁"
    fi
else
    echo "[pre-commit] ⚠️ 找不到 $ENC_SCRIPT，跳过编码门禁"
fi

# ---------- 1) ruff 门禁 ----------
# 检测 .py 文件 staged
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep "\.py$" || true)
if [ -z "$STAGED_PY" ]; then
    echo "[pre-commit] 无 .py 文件 staged，跳过 ruff 门禁"
    exit 0
fi

echo "[pre-commit] 检测到 .py staged 文件:"
echo "$STAGED_PY" | sed 's/^/  /'

# 优先用 python -m ruff（兼容所有平台），回退到 ruff 命令
RUFF_CMD=""
if command -v ruff >/dev/null 2>&1; then
    RUFF_CMD="ruff"
elif python -m ruff --version >/dev/null 2>&1; then
    RUFF_CMD="python -m ruff"
else
    echo "[pre-commit] ⚠️ ruff 未安装（PATH 或 python -m 都没），跳过门禁"
    echo "[pre-commit] 安装提示：pip install ruff"
    exit 0  # 缺工具不阻断（避免 CI 误判）
fi

# 1. ruff check
echo "[pre-commit] 跑 ruff check..."
if ! $RUFF_CMD check $STAGED_PY 2>&1; then
    echo "[pre-commit] ❌ ruff check 未通过，commit 阻断"
    exit 1
fi

# 2. ruff format --check
echo "[pre-commit] 跑 ruff format --check..."
if ! $RUFF_CMD format --check $STAGED_PY 2>&1; then
    echo "[pre-commit] ❌ ruff format --check 不一致，commit 阻断"
    exit 2
fi

echo "[pre-commit] ✅ ruff 门禁通过，commit 允许"
exit 0
