#!/usr/bin/env bash
# @version V3.0 / 2026-10-02 / pi / AgentMemoryHub 三道 **scope-gated** 提交门禁（薄包装）
#
# 本文件只是薄包装；门禁逻辑全在 `hub-engine/scripts/gate_runner.py --repo hub`（Python，可单测）。
#
# 为何重写（M0.5/Task 6）：
#   旧版三道门禁的**渲染一致性是无条件跑**的 ⇒ 工作树里**任何人**未提交的卡改动
#   会阻断**任何**提交。代价不是"慢"而是：大家学会用 `git commit --no-verify`，
#   于是编码门禁与 frontmatter 门禁**一起失效**（巡检曾连续 18 天未跑，同一机制）。
#   ⇒ 本版把渲染检查改成**只针对即将提交的内容**（`git checkout-index` 物化 index 后
#     在新目录里校验），于是"他人未提交的卡改动"不再阻断你的提交。
#
# 触发范围（由 staged 内容决定，见 `common/gate_scope.py`）：
#   text = staged 含 .md/文本 → check_encoding + markdownlint
#   l0   = staged 触及权威区卡/INDEX/渲染源 → startup_budget + render_index --check（staged 物化）
#   code = staged 含 .py（中枢仓一般没有）
#
# 退出码（由 gate_runner 给出）：0 通过 / 1 code / 2 text / 3 l0
# 安装：cp hub-engine/scripts/pre-commit-hub-cards AgentMemoryHub/.git/hooks/pre-commit
#       chmod +x AgentMemoryHub/.git/hooks/pre-commit

set -u

# 中枢仓的钩子里 cwd 可能是仓库根或任意目录：用脚本自身位置推导外层仓根
HUB_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
ENGINE="$(cd "$HUB_REPO_ROOT/.." 2>/dev/null && pwd)/hub-engine"
if [ ! -d "$ENGINE" ]; then
    echo "[hub-cards] ⚠️ 找不到 $ENGINE，跳过全部门禁（不阻断）"
    exit 0
fi

# ⚠️ 2026-10-10 修：把 POSIX 路径显式转成 Windows 形式再交给原生 python.exe。
# 为何必须：`cd ... && pwd` 得到 `/c/Users/...`；MSYS 默认会把参数自动转成 `C:/Users/...`，
# 但调用方若设了 `MSYS_NO_PATHCONV=1`（Hermes/agent shell 常见做法，避免误改参数），
# 转换就被关掉 ⇒ python 收到 `/c/Users/...`，在 Windows 上解析成 `C:\c\Users\...`
# （多一层 c）⇒ “can't open file …” ⇒ **一切提交被迫 `git commit --no-verify`**
# （实测复现：`MSYS_NO_PATHCONV=1 bash .git/hooks/pre-commit`）。
# 这里不依赖 MSYS 的自动转换：自己用 cygpath 转（Git for Windows 自带）。
to_win() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        printf '%s' "$1"
    fi
}
ENGINE_ARG="$(to_win "$ENGINE")"
ROOT_ARG="$(to_win "$HUB_REPO_ROOT")"

PY="python"
for cand in "$ENGINE/../.venv/Scripts/python.exe" "$ENGINE/../.venv/bin/python" python3 python; do
    if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
done

exec "$PY" "$ENGINE_ARG/scripts/gate_runner.py" --repo hub --repo-root "$ROOT_ARG"
