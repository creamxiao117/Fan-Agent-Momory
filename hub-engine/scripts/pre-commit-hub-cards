#!/usr/bin/env bash
# @version V1.2 / 2026-10-01 / Hermes + pi / AgentMemoryHub 提交前编码+卡片 frontmatter+渲染一致性 三门禁
#
# 作用（三道门禁）：
#   0) 渲染一致性：INDEX.md / INDEX-full.md 与卡文件不一致（手改产物/忘重渲）→ 阻断（exit 6）
#      依据：2026-10-01 单源改造（INDEX 改为渲染产物，见 docs/compose/plans/2026-10-01-*）
#   1) 编码门禁：staged 卡片 .md 跑 check_encoding.py（非 UTF-8 / 乱码串残留 → 阻断）
#      依据 rules/chinese-text-encoding-discipline v1.0。卡片全是中文，正是乱码高发区。
#   1) frontmatter 门禁：校验 staged 卡片 .md，不合规则**阻断提交**。
#      触发原因：2026-09-11 实测 11 张 type: experience 漂移卡经「Agent 直接写文件进
#      experience/」进入中枢并静默存活数周（不走 ingest ⇒ 不经过 validate_card，
#      而 lint 只扫 5 个权威区）。本钩子把校验关口前移到 commit ——
#      这是唯一能覆盖「直接写入路径」的拦截点。
#
# 安装：cp hub-engine/scripts/pre-commit-hub-cards AgentMemoryHub/.git/hooks/pre-commit
#       chmod +x AgentMemoryHub/.git/hooks/pre-commit
# 绕过：git commit --no-verify
#
# 退出码：
#   0 = 通过（无卡片 staged，或全部合规）
#   1 = 阻断（frontmatter 或编码不合规）
#   3 = 跳过（找不到 python，不阻断以免误伤 CI）
#   6 = 阻断（INDEX 渲染产物与卡文件不一致，2026-10-01 新增）
#
# 兼容：Windows(Git Bash) / Linux / macOS

set -e

HUB_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
ENGINE="$(dirname "$HUB_ROOT")/hub-engine"

PY=""
if command -v python >/dev/null 2>&1; then
    PY="python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    echo "[hub-cards] ⚠️ 找不到 python，跳过全部门禁（不阻断）"
    exit 3
fi

# ---------- 0) INDEX 渲染产物一致性（2026-10-01 单源改造）----------
# INDEX.md / INDEX-full.md 都是 `render_index` 的**渲染产物**（事实源=卡文件）。
# 手改产物、或改了卡忘重渲 → 索引与中枢不一致（**静默**：不影响检索，只骗人读）。
# 本检查**无条件跑**：因为 INDEX*.md 不在卡片目录里，若挂在「有卡片 staged」分支下，
# 单独提交一个手改的 INDEX-full.md 就会绕过它。口径同 `ruff format --check`。
if [ -f "$ENGINE/scripts/render_index.py" ]; then
    if RENDER_OUT=$(cd "$ENGINE" && $PY -m scripts.render_index --check 2>&1); then
        echo "[hub-cards] ✅ INDEX 渲染产物与卡文件一致"
    else
        echo "$RENDER_OUT" | grep -E "^FAIL" || echo "$RENDER_OUT"
        echo "[hub-cards] ❌ INDEX 渲染产物不一致，commit 阻断"
        echo "[hub-cards] 修法：cd hub-engine && python -m scripts.render_index --write"
        exit 6
    fi
else
    echo "[hub-cards] ⚠️ 找不到 $ENGINE/scripts/render_index.py，跳过渲染检查"
fi

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(rules|blueprints|methodology|longterm|projects|experience|notes)/.*\.md$' || true)
# 注：`--diff-filter` 不含 D（删除）——**刻意为之**：删除无内容可校验，
# 而「删卡后索引不同步」这件真正危险的事由上面的渲染一致性检查兜住（2026-10-01 实测）。

if [ -z "$STAGED_MD" ]; then
    echo "[hub-cards] 无卡片 .md staged，跳过卡片双门禁"
    exit 0
fi

# ---------- 0) 编码门禁（卡片全是中文，乱码高发）----------
ENC_SCRIPT="$ENGINE/scripts/check_encoding.py"
if [ -f "$ENC_SCRIPT" ]; then
    # shellcheck disable=SC2086
    if ENC_OUT=$(cd "$HUB_ROOT" && $PY "$ENC_SCRIPT" $STAGED_MD 2>&1); then
        ENC_RC=0
    else
        ENC_RC=$?
    fi
    echo "$ENC_OUT" | grep -E "^\[(FAIL|WARN)\]" || true
    if [ "$ENC_RC" -ne 0 ]; then
        echo "[hub-cards] ❌ 编码门禁未通过（见上），commit 阻断"
        exit 1
    fi
    echo "[hub-cards] ✅ 编码门禁通过"
else
    echo "[hub-cards] ⚠️ 找不到 $ENC_SCRIPT，跳过编码门禁"
fi

# ---------- 1) frontmatter 门禁 ----------
if [ ! -f "$ENGINE/scripts/check_card_frontmatter.py" ]; then
    echo "[hub-cards] ⚠️ 找不到校验器 $ENGINE/scripts/check_card_frontmatter.py，跳过"
    exit 3
fi

echo "[hub-cards] 卡片 frontmatter 门禁："
echo "$STAGED_MD" | sed 's/^/  /'

# shellcheck disable=SC2086
if ! $PY "$ENGINE/scripts/check_card_frontmatter.py" --root "$HUB_ROOT" $STAGED_MD; then
    echo "[hub-cards] ❌ frontmatter 不合规，commit 阻断（确需绕过用 git commit --no-verify）"
    exit 1
fi

echo "[hub-cards] ✅ 门禁通过，commit 允许"
exit 0
